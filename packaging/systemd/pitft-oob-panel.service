[Unit]
Description=Remote Management Panel for Raspberry Pi
After=local-fs.target con2fbmap.service NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/dev/fb0
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
User=pitft-oob
Group=pitft-oob
ExecStart=/usr/bin/pitft-oob-panel run-linux --config /etc/pitft-oob-panel/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StateDirectory=pitft-oob-panel
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=char-fb rw
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallFilter=~@clock @debug @module @mount @obsolete @raw-io @reboot @swap
SystemCallErrorNumber=EPERM
ProtectProc=invisible
MemoryMax=120M
CPUQuota=40%

[Install]
WantedBy=con2fbmap.service
